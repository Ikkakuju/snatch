# Website build-time values (packages/web). Baked into the static files; rebuild
# after changing. All optional.

# Public origin for canonical/og:url and sitemap.xml; empty omits them.
VITE_SITE_URL=
# Ad link opened in a new tab on the first click of the download button. Empty = no ad.
VITE_AD_URL=
# Microsoft Clarity analytics and browser error reporting.
VITE_CLARITY_ID=
VITE_SENTRY_DSN=
