{
	"name": "snatch",
	"private": true,
	"license": "MIT",
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "bun --filter '@snatch/web' dev",
		"build": "bun --filter '@snatch/web' build",
		"build:web": "bun --filter '@snatch/web' build",
		"preview": "bun --filter '@snatch/web' preview",
		"typecheck": "bun --filter '*' typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"check": "biome check --fix .",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/bun": "^1.4.4",
		"lefthook": "^2.2.2"
	}
}
